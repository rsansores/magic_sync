{
  "name": "shop-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,vue}\" \"*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"*.{ts,js,json}\"",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"*.{ts,js,json}\""
  },
  "dependencies": {
    "magic_sync_dashboard": "file:../../../dashboard",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
